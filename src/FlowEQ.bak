#include "RungeKutta.hpp"
#include "OneBody.hpp"
#include "TwoBody.hpp"
#include <iostream>
#include <vector>
#include <unordered_map>

// Helper structures for map keys
struct OneBodyKey {
    int s, ss;
    OneBodyKey(int s, int ss) : s(s), ss(ss) {}
    bool operator==(const OneBodyKey& other) const { return s == other.s && ss == other.ss; }
};

struct TwoBodyKey {
    int s1, s2, ss1, ss2;
    TwoBodyKey(int s1, int s2, int ss1, int ss2) : s1(s1), s2(s2), ss1(ss1), ss2(ss2) {}
    bool operator==(const TwoBodyKey& other) const {
        return std::tie(s1, s2, ss1, ss2) == std::tie(other.s1, other.s2, other.ss1, other.ss2);
    }
};

// Hash implementations
namespace std {
    template<> struct hash<OneBodyKey> {
        size_t operator()(const OneBodyKey& k) const {
            return hash<int>()(k.s) ^ (hash<int>()(k.ss) << 16);
        }
    };
    
    template<> struct hash<TwoBodyKey> {
        size_t operator()(const TwoBodyKey& k) const {
            return hash<int>()(k.s1) ^ (hash<int>()(k.s2) << 8) ^ 
                   (hash<int>()(k.ss1) << 16) ^ (hash<int>()(k.ss2) << 24);
        }
    };
}

RungeKutta::RungeKutta(Hamiltonian H, Generator eta) {
  set_zero_body_flow_eq(H, eta);
  set_one_body_flow_eq(H, eta);
  set_two_body_flow_eq(H, eta);
}

void RungeKutta::set_zero_body_flow_eq(Hamiltonian H, Generator eta) {
  std::vector<OneBody> f = H.get_one_body();
  std::vector<TwoBody> Gamma = H.get_two_body();

  std::vector<OneBody> eta_1body = eta.get_one_body();
  std::vector<TwoBody> eta_2body = eta.get_two_body();

  // E flow equation
  dEds = 0;

  const int f_size = f.size();
  const int eta_1body_size = eta_1body.size();
  const int gamma_size = Gamma.size();
  const int eta_2body_size = eta_2body.size();

#pragma omp parallel
  {
#pragma omp for reduction(+ : dEds)
    for (int i = 0; i < f_size; ++i) {
      if (f[i].s > 3 && f[i].ss < 4) {
        for (const OneBody &eta : eta_1body) {
          if (eta.s == f[i].ss && eta.ss == f[i].s) {
            dEds += f[i].me * eta.me;
          }
        }
      } else if (f[i].s < 4 && f[i].s > 3) {
        for (const OneBody &eta : f) {
          if (eta.s == f[i].ss && eta.ss == f[i].s) {
            dEds += -f[i].me * eta.me;
          }
        }
      }
    }
#pragma omp for reduction(+ : dEds)
    for (int i = 0; i < gamma_size; ++i) {
      if (Gamma[i].s1 > 3 && Gamma[i].s2 > 3 && Gamma[i].ss1 < 4 &&
          Gamma[i].ss2 < 4) {
        for (const TwoBody &eta : eta_2body) {
          if (eta.s1 == Gamma[i].ss1 && eta.s2 == Gamma[i].ss2 &&
              eta.ss1 == Gamma[i].s1 && eta.ss2 == Gamma[i].s2) {

            dEds += 0.5 * Gamma[i].me * eta.me;
          }
        }
      }
    }
  }
}

void RungeKutta::set_one_body_flow_eq(Hamiltonian H, Generator eta) {
    int num_states = H.get_num_states();
    auto& f = H.get_one_body();
    auto& gamma = H.get_two_body();
    auto& eta1 = eta.get_one_body();
    auto& eta2 = eta.get_two_body();

    const int f_size = f.size();
    const int eta1_size = eta1.size();
    const int gamma_size = gamma.size();
    const int eta2_size = eta2.size();

  std::unordered_map<OneBodyKey, double> global_dfds;

    #pragma omp parallel
    {
    std::unordered_map<OneBodyKey, double> local_dfds;

        // First sum: η*f terms
        #pragma omp for collapse(2)
        for (int i = 0; i < f_size; ++i) {
            for (int j = 0; j < eta1_size; ++j) {
                if (eta1[j].ss == f[i].s) {
                    const double val = eta1[j].me * f[i].me;
                    local_dfds[{eta1[j].s, f[i].ss}] += val;
                    local_dfds[{f[i].ss, eta1[j].s}] += val;
                }
            }
        }

        // Second sum: γ*η terms
        #pragma omp for
        for (int i = 0; i < gamma_size; ++i) {
            auto& g = gamma[i];
            
            // Case 1: s1 > 3 && ss1 < 4
            if (g.s1 > 3 && g.ss1 < 4) {
                for (auto& eta : eta1) {
                    if (eta.s == g.ss1 && eta.ss == g.s1) {
                        const double val = eta.me * g.me;
                        local_dfds[{g.s2, g.ss2}] += val;
                    }
                }
            }
            // Case 2: s1 < 4 && ss1 > 3
            else if (g.s1 < 4 && g.ss1 > 3) {
                for (auto& eta : eta1) {
                    if (eta.s == g.ss1 && eta.ss == g.s1) {
                        const double val = -eta.me * g.me;
                        local_dfds[{g.s2, g.ss2}] += val;
                    }
                }
            }
        }

        // Second sum continuation: η2*f terms
        #pragma omp for
        for (int i = 0; i < eta2_size; ++i) {
            auto& e2 = eta2[i];
            
            // Case 1: s1 > 3 && ss1 < 4
            if (e2.s1 > 3 && e2.ss1 < 4) {
                for (auto& f_j : f) {
                    if (f_j.s == e2.ss1 && f_j.ss == e2.s1) {
                        const double val = f_j.me * e2.me;
                        local_dfds[{e2.s2, e2.ss2}] += val;
                    }
                }
            }
            // Case 2: s1 < 4 && ss1 > 3 
            else if (e2.s1 < 4 && e2.ss1 > 3) {
                for (auto& f_j : f) {
                    if (f_j.s == e2.ss1 && f_j.ss == e2.s1) {
                        const double val = -f_j.me * e2.me;
                        local_dfds[{e2.s2, e2.ss2}] += val;
                    }
                }
            }
        }

        // Third sum: γ*η2 terms
        #pragma omp for
        for (int i = 0; i < gamma_size; ++i) {
            auto& g = gamma[i];
            
            // Case 1: s1,s2 < 4 && ss1 > 3
            if (g.s1 < 4 && g.s2 < 4 && g.ss1 > 3) {
                for (auto& e2 : eta2) {
                    if (e2.s1 == g.ss1 && e2.ss1 == g.s1 && e2.ss2 == g.s2) {
                        const double val = 0.5 * e2.me * g.me;
                        local_dfds[{e2.s2, g.ss2}] += val;
                        local_dfds[{g.ss2, e2.s2}] += val;
                    }
                }
            }
            
            // Case 2: s1,s2 > 3 && ss1 < 4
            if (g.s1 > 3 && g.s2 > 3 && g.ss1 < 4) {
                for (auto& e2 : eta2) {
                    if (e2.s1 == g.ss1 && e2.ss1 == g.s1 && e2.ss2 == g.s2) {
                        const double val = -0.5 * e2.me * g.me;
                        local_dfds[{e2.s2, g.ss2}] += val;
                        local_dfds[{g.ss2, e2.s2}] += val;
                    }
                }
            }
        }

        // Merge thread-local results
        #pragma omp critical
        {
            for (auto& [key, val] : local_dfds) {
                global_dfds[key] += val;
            }
        }
    }

    // Convert map to vector
    dfds.clear();
    dfds.reserve(global_dfds.size());
    for (auto& [key, val] : global_dfds) {
        dfds.emplace_back(key.s, key.ss, val);
    }
}

void RungeKutta::set_two_body_flow_eq(Hamiltonian H, Generator eta) {
    auto& f = H.get_one_body();
    auto& gamma = H.get_two_body();
    auto& eta1 = eta.get_one_body();
    auto& eta2 = eta.get_two_body();

    const int f_size = f.size();
    const int eta1_size = eta1.size();
    const int gamma_size = gamma.size();
    const int eta2_size = eta2.size();

  std::unordered_map<TwoBodyKey, double> global_dgammads;

    #pragma omp parallel
    {
    std::unordered_map<TwoBodyKey, double> local_dgammads;

        #pragma omp for
        for (int i = 0; i < gamma_size; ++i) {
            auto& g = gamma[i];
            
            for (auto& eta : eta1) {
                // Case 1: η.ss == γ.s1
                if (eta.ss == g.s1) {
                    const double val = eta.me * g.me;
                    local_dgammads[{eta.s, g.s2, g.ss1, g.ss2}] += val;
                    local_dgammads[{g.s2, eta.s, g.ss1, g.ss2}] -= val;
                }
                
                // Case 2: η.s == γ.ss1
                if (eta.s == g.ss1) {
                    const double val = -eta.me * g.me;
                    local_dgammads[{g.s1, g.s2, eta.ss, g.ss2}] += val;
                    local_dgammads[{g.s1, g.s2, g.ss2, eta.ss}] += -val;
                }
            }
        }

        // Additional terms from η2*γ combinations
        #pragma omp for
        for (int i = 0; i < eta2_size; ++i) {
            auto& e2 = eta2[i];
            
            for (auto& g : gamma) {
                // Case: η2.s1 == γ.ss1 && η2.ss1 == γ.s1
                if (e2.s1 == g.ss1 && e2.ss1 == g.s1) {
                    const double val = e2.me * g.me;
                    local_dgammads[{g.s2, e2.s2, g.ss2, e2.ss2}] += val;
                    local_dgammads[{e2.s2, g.s2, e2.ss2, g.ss2}] += -val;
                }
            }
        }

        #pragma omp critical
        {
            for (auto& [key, val] : local_dgammads) {
                global_dgammads[key] += val;
            }
        }
    }

    // Convert map to vector
    dGammads.clear();
    dGammads.reserve(global_dgammads.size());
    for (auto& [key, val] : global_dgammads) {
        dGammads.emplace_back(key.s1, key.s2, key.ss1, key.ss2, val);
    }
}

const void RungeKutta::print_zero_body() {
  std::cout << "dEds: " << dEds << std::endl;
}

const void RungeKutta::print_one_body() {
  std::cout << "dfds: " << std::endl;
  for (const OneBody &df : dfds) {
    std::cout << df.s << "\t" << df.ss << "\t" << df.me << std::endl;
  }
  std::cout << std::endl;
}

const void RungeKutta::print_two_body() {
  std::cout << "Gamma:" << std::endl;
  for (const TwoBody &dg : dGammads) {
    std::cout << dg.s1 << "\t" << dg.s2 << "\t" << dg.ss1 << "\t" << dg.ss2
              << "\t" << dg.me << std::endl;
  }
  std::cout << std::endl;
}
